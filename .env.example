# YouTube Music Downloader - Proxy Configuration
# Copy this file to .env and fill in your proxy credentials

# Enable proxy usage (true/false)
USE_PROXY=false

# Path to proxy configuration JSON file (optional)
# If not set, will try to load from environment variables below
PROXY_CONFIG_FILE=proxy_config.json

# Individual proxy configuration (if not using config file)
# Format: protocol://username:password@host:port

# IPRoyal Residential Proxy (cheapest option at $2.45/GB)
PROXY_1=http://YOUR_USERNAME:YOUR_PASSWORD@geo.iproyal.com:12321

# Smartproxy/Decodo Residential Proxy ($3.00/GB with 3-day trial)
PROXY_2=http://YOUR_USERNAME:YOUR_PASSWORD@gate.smartproxy.com:10000

# Oxylabs Residential Proxy ($3.49/GB)
PROXY_3=http://customer-YOUR_USERNAME:YOUR_PASSWORD@pr.oxylabs.io:7777

# Bright Data Datacenter Proxy ($7.14/GB)
PROXY_4=http://YOUR_USERNAME-session-rand123:YOUR_PASSWORD@zproxy.lum-superproxy.io:22225

# Local SOCKS5 proxy (if using VPN or SSH tunnel)
PROXY_5=socks5://127.0.0.1:1080

# Proxy rotation strategy
# Options: round_robin, random, best_performance, least_used, fastest
PROXY_STRATEGY=best_performance

# Maximum consecutive failures before blacklisting a proxy
PROXY_MAX_FAILURES=3

# Blacklist duration in minutes
PROXY_BLACKLIST_DURATION=30

# Health check interval in seconds
PROXY_HEALTH_CHECK_INTERVAL=300

# Fallback to direct connection if all proxies fail
PROXY_FALLBACK_DIRECT=true

# Prefer residential proxies for YouTube
PROXY_PREFER_RESIDENTIAL=true

# Browser for cookie extraction (chrome, firefox, edge, safari)
COOKIE_BROWSER=chrome

# Use cookies from browser
USE_COOKIES_FROM_BROWSER=true

# Path to manual cookies file (optional)
COOKIES_FILE=cookies.txt

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum concurrent downloads
MAX_WORKERS=8

# Request delays (in seconds)
MIN_SLEEP_INTERVAL=1
MAX_SLEEP_INTERVAL=8

# FFmpeg location (update if different)
FFMPEG_LOCATION=/usr/bin/ffmpeg